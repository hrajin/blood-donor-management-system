{
  "name": "bdms",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file=.env server/main.ts",
    "db:start": "mkdir -p .local/mongo-data && .local/mongodb/bin/mongod --dbpath .local/mongo-data --bind_ip 127.0.0.1 --port 27027 --fork --logpath .local/mongo.log",
    "db:stop": "kill $(cat .local/mongo-data/mongod.lock)",
    "db:seed": "node --env-file=.env scripts/seed-donors.ts",
    "locations:import": "node scripts/import-locations.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc -p server && tsc -p client",
    "test": "node --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
