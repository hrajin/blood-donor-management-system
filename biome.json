{
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!client/dist",
      "!.local",
      "!data",
      "!shared/locations.json",
      "!shared/hospitals.json",
      "!**/*.md"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  }
}
